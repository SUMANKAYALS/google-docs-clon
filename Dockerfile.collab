# ---------- Dependencies ----------
FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./

RUN npm ci

# ---------- Runner ----------
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=1234
ENV HOST=0.0.0.0

COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY scripts/collaboration-server.js ./scripts/collaboration-server.js

EXPOSE 1234

CMD ["node", "scripts/collaboration-server.js"]
